# Copy to .env and fill in. Never commit .env.
# Keys are read by the backend only; never put them in the page.

# LLM provider for the coach: gemini | claude
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown; model ids are not verified, change if the API rejects them)
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-haiku-5-5
COACH_TIMEOUT_MS=12000
RATE_LIMIT_PER_MIN=20
# PORT=8765
# TRUST_PROXY=1   # only behind a reverse proxy that sets X-Forwarded-For

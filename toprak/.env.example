# Copy to .env and fill in. Never commit .env.
# Keys are read by the backend only; never put them in the page.

# LLM provider for the coach: gemini | claude
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown; the Claude id is not verified yet)
# GEMINI_MODEL=gemini-3.5-flash-lite   # verified 2026-10-09; gemini-2.5-flash hit quota, 2.0-flash is retired
# ANTHROPIC_MODEL=claude-haiku-5-5
COACH_TIMEOUT_MS=12000
# per IP, kept below the Gemini free tier (15 requests/min per model)
RATE_LIMIT_PER_MIN=10
# PORT=8765
# TRUST_PROXY=1   # only behind a reverse proxy that sets X-Forwarded-For

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worldsmith/coach-schema.json",
  "title": "CoachResponse",
  "description": "What the AI coach returns for one learner turn. The server validates every model reply against this file before the page sees it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "message", "reveals_solution", "source"],
  "properties": {
    "stage": {
      "type": "string",
      "enum": ["diagnose", "teach", "challenge", "evaluate", "showcase"]
    },
    "missing_concept": {
      "type": ["string", "null"],
      "maxLength": 120,
      "description": "The one concept the learner is missing right now, or null when nothing is missing."
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "task": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["title", "goal", "starter_code", "success_criteria"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "goal": { "type": "string", "minLength": 1, "maxLength": 300 },
        "starter_code": { "type": "string", "maxLength": 1200 },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1, "maxLength": 140 }
        }
      }
    },
    "hint": {
      "type": ["string", "null"],
      "maxLength": 400
    },
    "verdict": {
      "type": ["string", "null"],
      "enum": ["pass", "partial", "fail", null]
    },
    "reveals_solution": {
      "const": false,
      "description": "Always false. A reply that reveals the solution is rejected by the server, never shown."
    },
    "source": {
      "type": "string",
      "enum": ["llm", "rules"]
    },
    "model": {
      "type": ["string", "null"],
      "maxLength": 80,
      "description": "Model id that produced the reply, set by the server for llm replies."
    }
  }
}
